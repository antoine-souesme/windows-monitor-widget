<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of the Microsoft Store package.

  Identity must never change: it is what ties an update to the installed copy,
  exactly like AppId in installer.iss. The three values come from the product
  identity page of the Partner Center.

  Version is rewritten by build_msix.ps1 from monitor_widget/version.py; the
  fourth number has to stay at zero, the Store reserves it.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="AntoineSouesme.MonitorWidget"
            Publisher="CN=FBE8A2FE-0B1A-4DC6-9A37-26D917854488"
            Version="0.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Monitor Widget</DisplayName>
    <PublisherDisplayName>Antoine Souesme</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="MonitorWidget"
                 Executable="MonitorWidget.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Monitor Widget"
          Description="Widget de bureau affichant une mesure système en direct."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Monitor Widget" />
      </uap:VisualElements>
      <Extensions>
        <!-- Replaces the HKCU\...\Run key: the user turns it off in the
             Windows startup settings, not from the widget menu. -->
        <uap5:Extension Category="windows.startupTask"
                        Executable="MonitorWidget.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="MonitorWidgetStartup"
                            Enabled="true"
                            DisplayName="Monitor Widget" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
